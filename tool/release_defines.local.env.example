# Mingtu AI 演示包编译期配置模板（示例）
#
# 用法：
#   cp tool/release_defines.local.env.example tool/release_defines.local.env
#   # 然后填入真实值，再执行：
#   bash tool/build_release_apk.sh
#
# 规则：
#   - 一行一个 KEY=VALUE；# 开头为注释；空值表示「该能力不配置」。
#   - tool/release_defines.local.env 已被 .gitignore 忽略，**绝不提交**。
#   - 同名环境变量优先于此文件；命令行 --dart-define 优先级最高。
#     例：MINGTU_AMAP_KEY=xxx bash tool/build_release_apk.sh
#   - 这些值是 --dart-define（编译期常量），会被编进 libapp.so，可以从 APK
#     里提取出来。所以只能用「一次性、演示后立刻作废」的凭据。
#   - 构建脚本只打印 KEY 名，绝不回显值；请不要把真实值贴进 issue/日志/文档。
#
# 构建后脚本会逐项校验每个非空值确实进了包，缺一项就构建失败。

# ---------------------------------------------------------------------------
# 路线（二选一，至少配一项；两项都空则导航/路线演示不可用）
# ---------------------------------------------------------------------------

# 高德 Web 服务 Key，用于「演示直连模式」（客户端直接调高德）。
# 生产 Key 绝不进 App；这里只放演示用可作废的临时 Key。
MINGTU_AMAP_KEY=

# 自建路线代理的 base URL（https://your-server），高德 Key 由服务端持有。
# URL 不是密钥，但同样按环境相关配置处理。
MINGTU_ROUTE_PROXY_URL=

# ---------------------------------------------------------------------------
# 云端识图（阿里云函数计算；百炼 Key 只在函数环境里，客户端没有）
# ---------------------------------------------------------------------------

# 识图函数 base URL，必须 https://，否则客户端拒绝使用。
MINGTU_VISION_PROXY_URL=

# 识图函数的演示令牌（不是百炼 Key），服务端先校验它再花钱，演示后作废。
MINGTU_VISION_TOKEN=

# ---------------------------------------------------------------------------
# 云端语音识别（可选）
# ---------------------------------------------------------------------------

# ASR 函数 base URL。留空则回落到 MINGTU_VISION_PROXY_URL
# （/asr 与 /vision 是同一个 FC 部署的路由，共用演示令牌）。
MINGTU_ASR_PROXY_URL=
